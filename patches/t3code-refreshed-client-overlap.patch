+          <TooltipPrimitive.Popup>
+            <Kbd className="h-4 min-w-0 rounded-sm border bg-popover px-1.5 text-[10px] shadow-md/5">
+              {props.label}
+            </Kbd>
+          </TooltipPrimitive.Popup>
+        </TooltipPrimitive.Positioner>
+      </TooltipPrimitive.Portal>
+    </TooltipPrimitive.Root>
+  );
+}
